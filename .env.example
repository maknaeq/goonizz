# Copier ce fichier en .env (ignoré par git) à côté de compose.watchtower.yml
# et renseigner une vraie valeur pour activer les notifications Watchtower.

# Format shoutrrr, à partir d'un webhook Discord :
# https://discord.com/api/webhooks/{id}/{token}  ->  discord://{token}@{id}
WATCHTOWER_NOTIFICATION_URL=discord://token@webhookid
